<?xml version='1.0' encoding='utf-8'?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>dnSpy.Backend.Core</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\dnSpy.Backend.Contracts\dnSpy.Backend.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The default response file the script engine reads, shipped beside the host. -->
    <None Include="Scripting\CSharpInteractive.rsp" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="dnSpy.Backend.Tests" />
    <!-- dnSpy.Console writes its documents with the GUI's decompilers, the way the WPF console loads dnSpy's. -->
    <InternalsVisibleTo Include="dnSpy.Console" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="dnlib" Version="4.5.0" />
    <PackageReference Include="ICSharpCode.Decompiler" Version="11.1.0.9782" />
    <PackageReference Include="ICSharpCode.CodeConverter" Version="10.0.1.923" />
    <PackageReference Include="ICSharpCode.BamlDecompiler" Version="11.1.0.9782" />
    <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" Version="10.0.12" />
    <!-- TIFF is one of the formats WPF's Image decodes and Chromium does not; the resource viewer converts it. -->
    <PackageReference Include="BitMiracle.LibTiff.NET" Version="2.4.660" />
    
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Scripting" Version="4.14.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="4.14.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.Workspaces.Common" Version="4.14.0" />
    <!-- Visual Basic's completion, Quick Info and signature help providers, for the Edit Code editor in Visual Basic. -->
    <PackageReference Include="Microsoft.CodeAnalysis.VisualBasic.Features" Version="4.14.0" />
  <PackageReference Include="System.Formats.Nrbf" Version="10.0.11" />
    <PackageReference Include="System.Resources.Extensions" Version="10.0.11" /></ItemGroup>
</Project>