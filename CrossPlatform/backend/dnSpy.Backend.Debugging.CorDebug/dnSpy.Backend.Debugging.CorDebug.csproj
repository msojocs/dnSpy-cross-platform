<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>dnSpy.Backend.Debugging.CorDebug</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Which DbgShim native asset to bring in. A publish names its RID, so it gets the shim of the
         platform it ships to; a plain build (the tests, a debug run) has no RID and gets the shim of
         the machine doing the build, which is the only platform it can run the engine on. The SDK's
         portable RID is used because the non-portable one is distro-specific (ubuntu.26.04-x64), and
         the DbgShim packages are published per portable RID. -->
    <DbgShimRuntimeIdentifier Condition="'$(DbgShimRuntimeIdentifier)' == ''">$(RuntimeIdentifier)</DbgShimRuntimeIdentifier>
    <DbgShimRuntimeIdentifier Condition="'$(DbgShimRuntimeIdentifier)' == ''">$(NETCoreSdkPortableRuntimeIdentifier)</DbgShimRuntimeIdentifier>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\dnSpy.Backend.Contracts\dnSpy.Backend.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The default exception types and categories, the same file the WPF engine ships. The service
         globs debug/*.ex.xml at startup, so this is data it reads rather than code it links. -->
    <None Include="debug\DotNet.ex.xml" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- The exception list is engine data rather than an API: the only caller is the session manager,
         which hands out its snapshot. The tests read it directly, so it stays internal and they get
         the assembly's internals. -->
    <InternalsVisibleTo Include="dnSpy.Backend.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- ICorDebugSharp wraps ICorDebug/IMetaDataImport and the DbgShim bootstrap API on top of
         source generated COM, so no native interop assembly of our own is needed. -->
    <PackageReference Include="ICorDebugSharp" Version="0.1.8" />
    <!-- The expression evaluator binds what the user typed with Roslyn against the debuggee's own
         modules and then interprets the bound tree (IOperation) with func-eval, so both languages the
         variables windows speak — C# and Visual Basic — get the compiler's own semantics. The versions
         are the ones the decompiler side already ships, so the host loads a single Roslyn. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.VisualBasic" Version="4.14.0" />
    <!-- The Disassembly window: x86/x64 native code of a jitted method, the disassembler WPF uses. -->
    <PackageReference Include="Iced" Version="1.21.0" />
    <PackageReference Include="Microsoft.Diagnostics.NETCore.Client" Version="0.2.745401" />
    <!-- Supplies the shim (libdbgshim.so, dbgshim.dll, libdbgshim.dylib). The .NET runtime ships
         mscordbi but not dbgshim, so this package is the only source of it; a RID-specific publish
         puts the native asset next to the host binary. The packages are RID-specific because that is
         how upstream publishes them, which is why they are matched to the RID by hand here. -->
    <PackageReference Include="Microsoft.Diagnostics.DbgShim.linux-x64" Version="10.0.745401" Condition="'$(DbgShimRuntimeIdentifier)' == 'linux-x64'" />
    <PackageReference Include="Microsoft.Diagnostics.DbgShim.win-x64" Version="10.0.745401" Condition="'$(DbgShimRuntimeIdentifier)' == 'win-x64'" />
    <PackageReference Include="Microsoft.Diagnostics.DbgShim.osx-arm64" Version="10.0.745401" Condition="'$(DbgShimRuntimeIdentifier)' == 'osx-arm64'" />
  </ItemGroup>

  <!-- Linux, Windows x64 and macOS arm64 are the platforms the release builds; anything else would
       silently ship a package whose debug engine reports itself unavailable. -->
  <Target Name="ValidateDbgShimRuntimeIdentifier" BeforeTargets="BeforeBuild">
    <Error Condition="'$(DbgShimRuntimeIdentifier)' != 'linux-x64' And '$(DbgShimRuntimeIdentifier)' != 'win-x64' And '$(DbgShimRuntimeIdentifier)' != 'osx-arm64'"
           Text="No DbgShim package is wired up for runtime identifier '$(DbgShimRuntimeIdentifier)'." />
  </Target>
</Project>
