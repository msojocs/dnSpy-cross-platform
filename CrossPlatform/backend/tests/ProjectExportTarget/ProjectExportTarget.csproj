<Project Sdk="Microsoft.NET.Sdk">
  <!-- What dnSpy's project export lays out files for: a form with its Designer file and .resx, a settings class,
       a strongly typed resource class with a satellite assembly, unsafe code, a Win32 icon and manifest, and an
       app.config. It is decompiled, not run, so it is built for Windows on any system. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>WinExe</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <UseAppHost>false</UseAppHost>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <SatelliteResourceLanguages>de</SatelliteResourceLanguages>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);CA1001;CA1303;CA1416;CA1812;CA1822;CA2213</NoWarn>
  </PropertyGroup>
</Project>
